<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Shoe Store</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background: #f4f4f4;
    }
    header {
      background: #333;
      color: white;
      padding: 1rem;
      text-align: center;
    }
    .container {
      max-width: 900px;
      margin: 2rem auto;
      padding: 0 1rem;
    }
    h1 {
      margin-bottom: 1rem;
    }
    .products {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .product {
      background: white;
      border: 1px solid #ddd;
      border-radius: 5px;
      padding: 1rem;
      width: calc(33% - 1rem);
      box-sizing: border-box;
      text-align: center;
    }
    .product img {
      max-width: 100%;
      height: auto;
      border-radius: 5px;
    }
    .product h2 {
      font-size: 1.2rem;
      margin: 0.5rem 0;
    }
    .product p {
      color: #555;
    }
    .price {
      font-weight: bold;
      margin: 0.5rem 0;
      color: #2a9d8f;
    }
    button {
      background: #2a9d8f;
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 3px;
      cursor: pointer;
    }
    button:hover {
      background: #21867a;
    }
    @media (max-width: 700px) {
      .product {
        width: calc(50% - 1rem);
      }
    }
    @media (max-width: 400px) {
      .product {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <header>
    <h1>Welcome to Shoe Store</h1>
  </header>
  <div class="container">
    <h2>Our Shoes</h2>
    <div class="products">
      <div class="product">
        <img src="https://via.placeholder.com/200x150?text=Running+Shoes" alt="Running Shoes" />
        <h2>Running Shoes</h2>
        <p>Comfortable and lightweight running shoes for everyday use.</p>
        <div class="price">$79.99</div>
        <button>Add to Cart</button>
      </div>
      <div class="product">
        <img src="https://via.placeholder.com/200x150?text=Casual+Sneakers" alt="Casual Sneakers" />
        <h2>Casual Sneakers</h2>
        <p>Stylish sneakers perfect for casual outings and daily wear.</p>
        <div class="price">$59.99</div>
        <button>Add to Cart</button>
      </div>
      <div class="product">
        <img src="https://via.placeholder.com/200x150?text=Leather+Boots" alt="Leather Boots" />
        <h2>Leather Boots</h2>
        <p>Durable leather boots for a rugged and fashionable look.</p>
        <div class="price">$120.00</div>
        <button>Add to Cart</button>
      </div>
    </div>
  </div>
</body>
</html>
